{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-key-1",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "zai": {
      "keys": [
        {
          "name": "zai-key-1",
          "value": "env.GLM_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.z.ai/api/anthropic",
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic",
        "request_path_overrides": {
          "chat_completion": "/v1/messages",
          "chat_completion_stream": "/v1/messages"
        }
      }
    },
    "swiftlet": {
      "keys": [
        {
          "name": "swiftlet-local-key",
          "value": "EMPTY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:8082",
        "max_retries": 1,
        "retry_backoff_initial": 200,
        "retry_backoff_max": 1000
      },
      "custom_provider_config": {
        "is_key_less": true,
        "base_provider_type": "openai",
        "request_path_overrides": {
          "chat_completion": "/v1/chat/completions",
          "chat_completion_stream": "/v1/chat/completions",
          "list_models": "/v1/models"
        }
      }
    }
  }
}
