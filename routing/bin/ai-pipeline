#!/usr/bin/env bash
# ai-pipeline — DeepSeek implements a spec, GLM reviews it, loop until PASS or rounds run out.
#   ai-pipeline <spec-dir> [max-rounds=3]
# <spec-dir> must contain spec.md (written by Opus). Run from the repo root.
# Artifacts land in <spec-dir>: base (git sha), impl-N.log, review-N.md, status.
set -euo pipefail
dir="${1:?usage: ai-pipeline <spec-dir> [max-rounds]}"; rounds="${2:-3}"
dir="$(cd "$dir" && pwd)"
[[ -f "$dir/spec.md" ]] || { echo "no $dir/spec.md" >&2; exit 2; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "run inside a git repo" >&2; exit 2; }

# Diff base: everything after this sha (committed or not) is the implementer's work.
[[ -f "$dir/base" ]] || git rev-parse HEAD > "$dir/base"
base="$(cat "$dir/base")"
printf '*.log\nbase\nstatus\n' > "$dir/.gitignore"   # keep pipeline noise out of the reviewed diff

# Spec must declare one line like:  Test command: `pytest -q tests/test_foo.py`
test_cmd="$(sed -nE 's/^[*_ -]*Test command:[*_ ]*`(.+)`.*$/\1/p' "$dir/spec.md" | head -1)"
[[ -n "$test_cmd" ]] || { echo "spec.md needs a line: Test command: \`...\`" >&2; exit 2; }

impl_prompt() {
  cat <<EOF
You are the implementer. The spec is $dir/spec.md: read it fully first. It is the source of truth; never edit it.
1. Write tests first that encode every item under "Expected behavior" and "Edge cases".
2. Implement until the spec's test command passes. Run it and iterate; don't stop at a failing state.
3. Stay within the spec's scope. Do not weaken, skip, or delete tests to make them pass.
4. When done, write $dir/impl-notes.md: files changed, how each spec item is covered, anything you could not do and why.
EOF
  if [[ -n "${1:-}" ]]; then
    printf '\nA reviewer rejected the previous round. Fix every BLOCKER and MAJOR finding in %s, re-run the tests, and update impl-notes.md.\n' "$1"
  fi
}

review_prompt() {
  cat <<EOF
You are the reviewer. Do not modify any files. Inputs:
- Spec and plan: $dir/spec.md
- Implementer notes: $dir/impl-notes.md
- The change: run \`git diff $base\` and \`git status --short\` (untracked files are part of the change; read them too).
- Test results: $dir/test-$n.log (output of \`$test_cmd\`, run by the pipeline after implementation; trust this over the notes).
Do:
1. Check every spec requirement, expected behavior, and edge case is implemented AND tested. List any gaps.
2. Hunt bugs: logic errors, off-by-ones, unhandled errors, races, resource leaks, security issues.
3. Look for regressions in code the change touches or calls; failing tests in test-$n.log are at least MAJOR.
4. Poke holes: inputs or states the spec and tests miss; tests that pass without proving anything.
Output markdown: findings grouped as BLOCKER / MAJOR / MINOR, each with file:line and a concrete failure scenario.
The final line must be exactly \`VERDICT: PASS\` (no BLOCKER or MAJOR findings) or \`VERDICT: FAIL\`.
EOF
}

prev_review=""
for ((n = 1; n <= rounds; n++)); do
  echo "── round $n: implementing (deepseek)"
  ai-agent deepseek -p "$(impl_prompt "$prev_review")" --dangerously-skip-permissions \
    > "$dir/impl-$n.log" 2>&1 || echo "implementer exited non-zero (see impl-$n.log)"

  echo "── round $n: running tests"
  tests_ok=1
  bash -c "$test_cmd" > "$dir/test-$n.log" 2>&1 || { tests_ok=0; echo "tests: FAIL (exit $?)" | tee -a "$dir/test-$n.log"; }
  ((tests_ok)) && echo "tests: pass"

  echo "── round $n: reviewing (glm)"
  ai-agent glm -p "$(review_prompt)" \
    --allowedTools Read Grep Glob "Bash(git diff:*)" "Bash(git status:*)" "Bash(git log:*)" "Bash(git show:*)" \
    --disallowedTools Edit Write NotebookEdit \
    --permission-mode dontAsk 2>/dev/null \
    > "$dir/review-$n.md" || true

  verdict="$(grep -Eo 'VERDICT: (PASS|FAIL)' "$dir/review-$n.md" | tail -1 || true)"
  echo "── round $n: ${verdict:-VERDICT: MISSING}"
  if [[ "$verdict" == "VERDICT: PASS" && $tests_ok == 0 ]]; then
    echo "── reviewer said PASS but tests fail; treating as FAIL"
    printf '\n## Pipeline override\nBLOCKER: test command fails, see %s\nVERDICT: FAIL\n' "$dir/test-$n.log" >> "$dir/review-$n.md"
    verdict="VERDICT: FAIL"
  fi
  if [[ "$verdict" == "VERDICT: PASS" ]]; then
    echo "PASS after $n round(s)" > "$dir/status"; cat "$dir/status"; exit 0
  fi
  prev_review="$dir/review-$n.md"
done
echo "FAIL after $rounds round(s); last review: $prev_review" > "$dir/status"; cat "$dir/status"; exit 1
